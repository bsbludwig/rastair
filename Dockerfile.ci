# Runs the external-tool tests (tests/bam_external_tools.rs) on a machine that
# cannot run them natively — in practice macOS, because neither modkit nor the
# Bismark release tarball ships a macOS build. On Linux you do not need this
# image: see .github/scripts/install-external-tools.sh.
#
#   docker build -f Dockerfile.ci -t rastair-ext-tests .
#   docker run --rm -v "$(pwd):/rastair" rastair-ext-tests
#
# CI does not build this file: the `external-tools` job in
# .github/workflows/ci.yml installs the same tools straight onto the runner, so
# it shares the cargo cache. That job is the source of truth for how these tests
# run; if this image fails, compare against it. Nothing builds this image
# automatically, so it can rot.
#
# It is not equivalent to CI: there is no R here, so tests/mbias_report.rs
# self-skips, while CI installs r-base-core + r-cran-* and renders the QC
# report. Bismark and modkit come from bioconda at the versions pinned in
# install-external-tools.sh, so a packaging difference can still show up in one
# place and not the other.

FROM condaforge/mambaforge:latest

ENV DEBIAN_FRONTEND=noninteractive

# Install system deps for building rust-htslib
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config curl ca-certificates libclang-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust. `--default-toolchain none` leaves the version to
# rust-toolchain.toml, so the dependency prebuild below runs on the toolchain
# the tests use.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- --default-toolchain none --profile minimal -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /rastair
COPY rust-toolchain.toml ./
RUN channel="$(sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' rust-toolchain.toml)" \
    && test -n "$channel" \
    && rustup toolchain install "$channel" --profile default --no-self-update \
    && rustup default "$channel" \
    && rustup component add llvm-tools-preview \
    && rustc --version

# Install bioinformatics tools. Bismark and modkit carry the versions pinned
# in .github/scripts/install-external-tools.sh: an unpinned `bismark` is the
# `bismark-rust-v3.x` rewrite, which aborts on the paired test BAM.
RUN mamba install -y -c bioconda -c conda-forge \
    samtools \
    bismark=0.25.1 \
    ont-modkit=0.6.4 \
    && mamba clean -afy

# Install uv (Python package manager); pre-cache modbedtools so uvx works offline.
# UV_CACHE_DIR is set so the same cache path is used at both build and run time.
ENV UV_CACHE_DIR=/root/.cache/uv
RUN pip install uv && uvx modbedtools --help

# Prepopulate cargo registry and dependency build cache:
# copy only manifests + dep sources, build deps once, then copy real source.
COPY Cargo.toml Cargo.lock LICENSE.txt ./
COPY tools/ tools/
# Create stub src so cargo can resolve the workspace and fetch+build deps
RUN mkdir -p src && echo 'fn main() {}' > src/main.rs && \
    cargo fetch && \
    cargo test --features external-tool-tests --no-run 2>/dev/null || true && \
    rm -rf src

CMD ["cargo", "test", "--features", "external-tool-tests", "--test", "bam_external_tools", "--", "--nocapture"]
